<?xml version="1.0" encoding="utf-8"?>
<!-- Modified by the Strix contributors (fork of WordCraft); see NOTICE. -->
<!--
  Strix MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus its UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2` and the same for WixToolset.Util.wixext).
  Built by package.ps1:

    wix build strix.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d BinDir=... -d IconPath=... -d LicenseRtf=... [-d Scope=perUserOrMachine] -o out.msi

  Per-machine install into Program Files with a Start Menu shortcut. The installer shows the
  standard WiX dialogs: welcome + license, progress, and a finish page.

  Built a second time with -d Scope=perUserOrMachine for people without administrator rights
  (#39): a dual-purpose package that WiX gives ALLUSERS=2 and MSIINSTALLPERUSER=1, so it installs
  for the current user with no UAC prompt. Windows then redirects Program Files to
  %LOCALAPPDATA%\Programs, the Start Menu to the user's own, and HKMU to HKCU, so the same
  components work in both packages. Both share the UpgradeCode: each upgrades its own earlier
  versions (Windows Installer only matches products installed in the same context).

  UpgradeCode and the component GUIDs below belong to Strix alone. Never copy them from (or
  into) a sibling Craft app: Windows Installer treats every package sharing an UpgradeCode as one
  product, so a shared code makes one app's installer refuse to install ("a newer version is
  already installed") or silently uninstall the other. packaging-lint.yml checks this.
-->
<?ifndef Scope?>
<?define Scope = perMachine?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif ?>
  <Package
      Name="Strix"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="075497F9-E861-45D0-9C7F-A74F8C34E6BA"
      Scope="$(var.Scope)"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Strix word processor" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Strix is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="StrixIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="StrixIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/nabre/strix" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/nabre/strix" />
    <Property Id="ARPHELPLINK" Value="https://github.com/nabre/strix/issues" />

    <!-- Installer UI (#198): WixUI_Minimal is welcome + license, progress, then a finish page so
         people can see the install worked. Its dialogs and bitmaps are WiX's own
         (WixToolset.UI.wixext); package.ps1 builds the license RTF from LICENSE-MIT and
         LICENSE-APACHE. The finish page offers to launch Strix (ticked by default) through
         WixShellExec (WixToolset.Util.wixext); silent installs (/qn) never show it. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Strix" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#StrixExe]" />
    <CustomAction Id="LaunchStrix" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
        Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchStrix"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Strix" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Strix" Level="1">
      <ComponentGroupRef Id="AppNotices" />
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif ?>
      <ComponentGroupRef Id="StrixFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppNotices" Directory="INSTALLFOLDER">
      <Files Include="$(var.AppNoticesDir)\**" />
    </ComponentGroup>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif ?>
    <ComponentGroup Id="StrixFiles" Directory="INSTALLFOLDER">
      <Component Id="StrixApp" Guid="855DCEC6-9285-444F-9382-9654B83B34F6">
        <File Id="StrixExe" Source="$(var.BinDir)\strix.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Strix"
              Description="Strix word processor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="StrixIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\strix.exe" Value="[#StrixExe]" Type="string" />
      </Component>

      <!-- File associations (#295). Each document type gets a Strix ProgId (name, icon, open
           command) and is listed under the extension's OpenWithProgids, so Strix shows in
           Explorer's "Open with". The Word, RTF and ODT types are also Strix's Capabilities
           (RegisteredApplications), so it appears in Settings › Default apps, where the user
           makes it the default (File › Options › General opens that page). Nothing here sets an
           extension's default except Strix's own .xmath and .xmathm: the installer never takes over
           .docx from another app. Markdown and
           plain text are only "Open with" candidates. Removed again on uninstall. -->
      <Component Id="StrixFileTypes" Guid="EFF89E6A-F9B8-49F9-B3AE-E243347484B4">
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="Strix" Value="Software\Strix\Capabilities" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\Strix\Capabilities" Name="ApplicationName" Value="Strix" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Strix\Capabilities" Name="ApplicationDescription" Value="Write and design documents; open and export Word files." Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Strix\Capabilities" Name="ApplicationIcon" Value="&quot;[#StrixExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\strix.exe" Name="FriendlyAppName" Value="Strix" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\strix.exe\shell\open\command" Value="&quot;[#StrixExe]&quot; &quot;%1&quot;" Type="string" />

        <!-- Strix's own types (.xmath documents, .xmathm templates): the only ones Strix owns,
             so these extensions point at Strix's ProgIds by default. -->
        <ProgId Id="Strix.Xmath" Description="Strix Document" Icon="StrixExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Strix.Xmath\shell\open\command" Value="&quot;[#StrixExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.xmath" Value="Strix.Xmath" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.xmath" Name="Content Type" Value="application/vnd.strix.xmath" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.xmath\OpenWithProgids" Name="Strix.Xmath" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\strix.exe\SupportedTypes" Name=".xmath" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Strix\Capabilities\FileAssociations" Name=".xmath" Value="Strix.Xmath" Type="string" />

        <ProgId Id="Strix.Xmathm" Description="Strix Template" Icon="StrixExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Strix.Xmathm\shell\open\command" Value="&quot;[#StrixExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.xmathm" Value="Strix.Xmathm" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.xmathm" Name="Content Type" Value="application/vnd.strix.xmathm" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.xmathm\OpenWithProgids" Name="Strix.Xmathm" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\strix.exe\SupportedTypes" Name=".xmathm" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Strix\Capabilities\FileAssociations" Name=".xmathm" Value="Strix.Xmathm" Type="string" />

        <ProgId Id="Strix.Document" Description="Word Document" Icon="StrixExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Strix.Document\shell\open\command" Value="&quot;[#StrixExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.docx\OpenWithProgids" Name="Strix.Document" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\strix.exe\SupportedTypes" Name=".docx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Strix\Capabilities\FileAssociations" Name=".docx" Value="Strix.Document" Type="string" />

        <ProgId Id="Strix.DocumentMacroEnabled" Description="Word Macro-Enabled Document" Icon="StrixExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Strix.DocumentMacroEnabled\shell\open\command" Value="&quot;[#StrixExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.docm\OpenWithProgids" Name="Strix.DocumentMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\strix.exe\SupportedTypes" Name=".docm" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Strix\Capabilities\FileAssociations" Name=".docm" Value="Strix.DocumentMacroEnabled" Type="string" />

        <ProgId Id="Strix.Template" Description="Word Template" Icon="StrixExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Strix.Template\shell\open\command" Value="&quot;[#StrixExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.dotx\OpenWithProgids" Name="Strix.Template" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\strix.exe\SupportedTypes" Name=".dotx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Strix\Capabilities\FileAssociations" Name=".dotx" Value="Strix.Template" Type="string" />

        <ProgId Id="Strix.TemplateMacroEnabled" Description="Word Macro-Enabled Template" Icon="StrixExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Strix.TemplateMacroEnabled\shell\open\command" Value="&quot;[#StrixExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.dotm\OpenWithProgids" Name="Strix.TemplateMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\strix.exe\SupportedTypes" Name=".dotm" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Strix\Capabilities\FileAssociations" Name=".dotm" Value="Strix.TemplateMacroEnabled" Type="string" />

        <ProgId Id="Strix.LegacyDocument" Description="Legacy Word Document" Icon="StrixExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Strix.LegacyDocument\shell\open\command" Value="&quot;[#StrixExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.doc\OpenWithProgids" Name="Strix.LegacyDocument" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\strix.exe\SupportedTypes" Name=".doc" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Strix\Capabilities\FileAssociations" Name=".doc" Value="Strix.LegacyDocument" Type="string" />

        <ProgId Id="Strix.LegacyTemplate" Description="Legacy Word Template" Icon="StrixExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Strix.LegacyTemplate\shell\open\command" Value="&quot;[#StrixExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.dot\OpenWithProgids" Name="Strix.LegacyTemplate" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\strix.exe\SupportedTypes" Name=".dot" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Strix\Capabilities\FileAssociations" Name=".dot" Value="Strix.LegacyTemplate" Type="string" />

        <ProgId Id="Strix.RichText" Description="Rich Text Document" Icon="StrixExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Strix.RichText\shell\open\command" Value="&quot;[#StrixExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.rtf\OpenWithProgids" Name="Strix.RichText" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\strix.exe\SupportedTypes" Name=".rtf" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Strix\Capabilities\FileAssociations" Name=".rtf" Value="Strix.RichText" Type="string" />

        <ProgId Id="Strix.OpenDocumentText" Description="OpenDocument Text" Icon="StrixExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Strix.OpenDocumentText\shell\open\command" Value="&quot;[#StrixExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.odt\OpenWithProgids" Name="Strix.OpenDocumentText" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\strix.exe\SupportedTypes" Name=".odt" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Strix\Capabilities\FileAssociations" Name=".odt" Value="Strix.OpenDocumentText" Type="string" />

        <ProgId Id="Strix.Markdown" Description="Markdown Document" Icon="StrixExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Strix.Markdown\shell\open\command" Value="&quot;[#StrixExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.md\OpenWithProgids" Name="Strix.Markdown" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\strix.exe\SupportedTypes" Name=".md" Value="" Type="string" />

        <ProgId Id="Strix.PlainText" Description="Text Document" Icon="StrixExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Strix.PlainText\shell\open\command" Value="&quot;[#StrixExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.txt\OpenWithProgids" Name="Strix.PlainText" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\strix.exe\SupportedTypes" Name=".txt" Value="" Type="string" />
      </Component>

      <Component Id="StrixCli">
        <File Id="StrixCliExe" Source="$(var.BinDir)\strix-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
