<?xml version="1.0" encoding="UTF-8"?>
<!-- Modified by the Strix contributors (fork of WordCraft); see NOTICE. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>Strix</string>
  <key>CFBundleName</key>
  <string>Strix</string>
  <key>CFBundleExecutable</key>
  <string>Strix</string>
  <key>CFBundleIdentifier</key>
  <string>io.github.nabre.strix</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>StrixVersion</key>
  <string>@VERSION@</string>
  <key>StrixBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>Strix</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the Strix contributors and the WordCraft authors. MIT OR Apache-2.0.</string>

  <!-- Documents Strix opens. Its own .xmath documents and .xmathm templates come first and are
       owned by Strix; the other formats are imported and exported. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Strix Document</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>io.github.nabre.strix.xmath</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Strix Template</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>io.github.nabre.strix.xmathm</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Word Document</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>org.openxmlformats.wordprocessingml.document</string>
        <string>org.openxmlformats.wordprocessingml.template</string>
        <string>com.microsoft.word.doc</string>
        <string>org.oasis-open.opendocument.text</string>
        <string>public.rtf</string>
        <string>net.daringfireball.markdown</string>
        <string>public.html</string>
        <string>public.plain-text</string>
      </array>
    </dict>
  </array>

  <!-- Strix's own file types: OOXML (OPC) packages, so zip archives underneath. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>io.github.nabre.strix.xmath</string>
      <key>UTTypeDescription</key>
      <string>Strix Document</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.zip-archive</string>
        <string>public.composite-content</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>xmath</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>application/vnd.strix.xmath</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>io.github.nabre.strix.xmathm</string>
      <key>UTTypeDescription</key>
      <string>Strix Template</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.zip-archive</string>
        <string>public.composite-content</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>xmathm</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>application/vnd.strix.xmathm</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
